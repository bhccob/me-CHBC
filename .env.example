# The message form (api/contact.ts). On the live site these are set in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# API key from https://resend.com (free plan is enough).
RESEND_API_KEY=

# The inbox the form's messages are delivered to. TODO Bob.
CONTACT_TO=

# Who the email is "from". Needs a domain verified at Resend, e.g. "Bob Chung <hello@bhccob.com>".
# Left empty, Resend's own test sender is used, which only delivers to the address of the Resend account.
CONTACT_FROM=

# Local testing only: set to 1 in a local .env and the form answers "sent" without sending anything.
CONTACT_DRY_RUN=
