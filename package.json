{
  "name": "me-chbc",
  "version": "3.0.0",
  "description": "Bob Chung's portfolio, The Lock: a scroll-driven 3D site built on a six-piece Lu Ban lock. Vite, TypeScript and three.js.",
  "type": "module",
  "private": true,
  "author": "Bob Chung",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "fonts": "node tools/fonts.mjs",
    "icons": "node tools/icons.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
